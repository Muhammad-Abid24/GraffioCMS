# Root .env.example
# Copy to .env.local and configure

# Database (shared by packages/db)
# Dapatkan DATABASE_URL dari dashboard Supabase (Connection string -> URI)
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/graffio_dev

# Supabase Public Keys (Jika menggunakan Supabase Client di frontend)
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
