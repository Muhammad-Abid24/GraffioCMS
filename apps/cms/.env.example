# apps/cms/.env.example
# CMS URL (used for internal references, cookies)
NEXT_PUBLIC_CMS_URL=https://cms.example.com

# Public site URL (for linking to published content)
PUBLIC_SITE_URL=https://example.com

# Session absolute lifetime in seconds (default: 18000 = 5 hours)
SESSION_MAX_AGE_SECONDS=18000

# Google Analytics 4 — server-side dashboard (DISABLED until configured)
# Property ID from GA4 admin (e.g., 123456789)
GA4_PROPERTY_ID=

# Service account JSON for GA4 Data API (server-only, never expose as NEXT_PUBLIC_*)
GA4_SERVICE_ACCOUNT_JSON=

# Sentry error tracking (DISABLED until DSN configured)
SENTRY_DSN=

# Mail provider for forgot/reset password (DISABLED until configured)
# Email address used as sender
MAIL_FROM=
# API key for the configured mail provider (e.g., Resend, SendGrid)
MAIL_PROVIDER_API_KEY=

# Database URL (from packages/db, server-only)
DATABASE_URL=postgresql://user:password@localhost:5432/graffio_dev
